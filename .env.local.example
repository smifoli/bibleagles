# Supabase — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# API.Bible — https://scripture.api.bible/
BIBLE_API_KEY=your-api-bible-key

# OneSignal — https://onesignal.com/
NEXT_PUBLIC_ONESIGNAL_APP_ID=your-onesignal-app-id

# Web Push (notificações reais no aparelho) — gerar com `npx web-push generate-vapid-keys`.
# Só a chave pública entra aqui; a privada é secret só da Edge Function send-push
# (`supabase secrets set VAPID_PRIVATE_KEY=...`), nunca do app Next.js.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
